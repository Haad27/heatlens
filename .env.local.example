# Copy this file to `.env.local` and fill in the values you have.
# The app boots and is fully demoable with every key left blank:
# temperature, hourly comfort and census vulnerability fall back to clearly
# labelled demo data, and the language-model phrasing layer falls back to a
# rule-based template. Never silently treat demo figures as measurements.

# -----------------------------------------------------------------------------
# FortyGuard Temperature API  (required for live heat data)
# -----------------------------------------------------------------------------
# What it is: hyperlocal 2 m air temperature — historical, near-real-time and
# 12-hour forecast — plus exceedance and persistence layers.
# Sign up: https://fortyguard.com/hackathon26  or  https://dashboard.fortyguard.com
# Free trial / credits: Hackathon'26 programme, or a trial key from the dashboard.
# Where to paste: FORTYGUARD_API_KEY below.
# If missing: the deterministic urban-heat simulator in src/lib/fortyguard/mock.ts
# is used instead, and the UI shows a "Demo data" badge.
FORTYGUARD_API_KEY=

# Force the simulator on even when a key is present. Useful for UI work.
# Accepts true / 1 / yes.
FORTYGUARD_MOCK_MODE=

# Override only if FortyGuard changes their base URL.
# FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1

# -----------------------------------------------------------------------------
# US Census Bureau ACS  (required for live population vulnerability)
# -----------------------------------------------------------------------------
# What it is: American Community Survey 5-year estimates — population, age 65+,
# poverty, vehicle access — used to compute the Heat Vulnerability Score.
# Sign up (instant, free): https://api.census.gov/data/key_signup.html
# Free tier: unlimited for reasonable public use; key is required as of 2025.
# Where to paste: CENSUS_API_KEY below.
# If missing: vulnerability is labelled demo (when DEMO_MODE is on) or shown as
# unavailable, and dropped from the severity weighting.
CENSUS_API_KEY=

# -----------------------------------------------------------------------------
# Google Gemini API / Anthropic Claude  (optional — narrative phrasing only)
# -----------------------------------------------------------------------------
# What it is: turns already-computed hotspot + factor + vulnerability numbers
# into the executive-summary prose. It is never asked to invent a figure.
# Where to paste: GEMINI_API_KEY or ANTHROPIC_API_KEY below.
# If missing: src/lib/generateInsights.ts uses a deterministic template.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemma-2-27b-it,gemma-2-9b-it,gemini-2.0-flash,gemini-1.5-flash

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# -----------------------------------------------------------------------------
# Cache (optional — recommended in production)
# -----------------------------------------------------------------------------
# What it is: persistent cache for FortyGuard responses. FortyGuard bills per
# completed task, so this is a cost control, not an optimisation.
# Vercel KV is auto-provisioned when you link a KV store to the project in the
# Vercel dashboard (Storage → Create → KV). It injects KV_REST_API_URL and
# KV_REST_API_TOKEN. Upstash's own dashboard uses the UPSTASH_* names; either
# pair works.
# Locally: without these, the cache is in-memory plus a `.cache/` directory.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Demo behaviour
# -----------------------------------------------------------------------------
# When true (the default), missing Census / other credentials produce clearly
# labelled synthetic values so the product can be demonstrated end to end.
# Set to false in a production deployment so missing credentials render as
# "unavailable" instead of placeholder numbers.
# DEMO_MODE=true
